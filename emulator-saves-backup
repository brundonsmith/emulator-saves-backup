#!/usr/bin/env bash
# /etc/systemd/system-sleep/deckpush
# Called with arguments: pre|post <sleep-type>

# Run only on pre-suspend (before sleep)
if [ "$1" = "pre" ]; then
    export SYNC_LOCAL="/home/deck/ROMs/Emulation/saves"
    export SYNC_REMOTE="/emulator-saves-backup/steam-deck"
    export DROPBOX_APP_KEY="your_app_key"
    export DROPBOX_APP_SECRET="your_app_secret"
    export DROPBOX_REFRESH_TOKEN="your_refresh_token"

    /usr/local/bin/deckpush >> /var/log/deckpush.log 2>&1
fi